+      if (sql.includes("as same;")) return { rows: [{ pid: 1001, name: "postgres", same: true }], rowCount: 1 };
+      if (sql.includes("select pg_backend_pid() as pid")) return { rows: [{ pid: 1002, oid: "20000", same: true }], rowCount: 1 };
