+      if (servername === "wrong.invalid") expect(result.output).toContain("ERR_TLS_CERT_ALTNAME_INVALID");
+    } finally {
+      await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    }
+  });
+});
