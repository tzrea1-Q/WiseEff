+    expect(pinned.every(({ env: child }) => Object.keys(child).sort().join() === "HOME,PATH")).toBe(true);
+    expect(JSON.stringify(fake.calls)).not.toContain("secret");
+  });
+  it("refuses daemon replacement before subsequent mutation", () => {
+    const fake = fixture();
