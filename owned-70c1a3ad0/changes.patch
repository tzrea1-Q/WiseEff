+      async close() { if (!closed) { closed = true; await authDb.close(); } },
+    });
+  } catch (error) {
+    await db?.close().catch(() => undefined);
+    if (error instanceof DeploymentAuthorityError) throw error;
+    return refuse("AUTHENTICATION-UNAVAILABLE");
+  }
+}
