@@ -46,6 +46,76 @@ type DatabaseOptions = {
   tracing?: Pick<TracingBoundary, "withSpan">;
 };
 
+type PostgresDatabaseOptions = DatabaseOptions & {
+  /** Server-owned observation of this actual lease, before caller SQL/BEGIN.
