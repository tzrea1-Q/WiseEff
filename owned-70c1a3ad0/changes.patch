+import { randomBytes } from "node:crypto";
+import path from "node:path";
+import pg from "pg";
+import { afterAll, beforeAll, expect, it } from "vitest";
+import { createSelfHostedPg16Database } from "../../../testing/selfHostedUpgrade/database";
