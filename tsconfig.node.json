{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@wiseeff/dto-schemas": ["./server/modules/contracts/dtoSchemas/index.ts"]
    },
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "vitest.server.config.ts", "src/vite-env.d.ts", "server/**/*.ts", "scripts/**/*.ts", "ops/self-hosted/scripts/parameter-catalog-upgrade/handoff.ts", "ops/self-hosted/scripts/parameter-catalog-upgrade/managementPreparation.ts", "ops/self-hosted/scripts/parameter-catalog-upgrade/deploymentAuthority.ts", "ops/self-hosted/scripts/parameter-catalog-upgrade/reportApprovalTarget.ts", "ops/self-hosted/scripts/parameter-catalog-upgrade/recoveryApproval.ts", "ops/self-hosted/storage/controlledRecovery.docker.ts"],
  "exclude": ["**/*.test.ts"]
}
