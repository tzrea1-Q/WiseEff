/*
 * Issue #849 scope item 2 - example DTS project-source baseline for the vendor
 * slice. GENERATED by scripts/generate-vendor-project-source.ts from the reviewed
 * seed reconciliation manifest; do not hand-edit.
 *
 * Coverage: 115 of 115 reviewed vendor inputs are expressed here
 * (27 driver subjects, 13 node-type subjects).
 *
 * DEMONSTRATION SOURCE - not validated real-device firmware and not a device
 * deployment input. Every value is the reviewed vendor metadata's own `exampleValue`,
 * emitted as the DTS literal; nothing is invented and nothing is read from the
 * published Catalog schema.
 *
 * The 0 inputs with a shape that has no DTS example are the only ones
 * omitted. The 8 YAML/TOML/ENV compatibility items stay deferred to TD-124.
 *
 * Overlay-only by design: an unresolved `&label` is an L1 `dangling-reference`
 * warning that self-anchors, and L2 compile uses an ephemeral, non-persisted stub
 * (server/modules/dts/danglingAnchorStub.ts). No synthetic base tree is committed.
 */
/dts-v1/;
/plugin/;

/ {
	arm_amba_bus {
		compatible = "arm,amba-bus";
		interrupt-parent = <&gic>;
	};

	hisilicon_hisi_bci_battery {
		compatible = "hisilicon,hisi_bci_battery";
		battery_board_type = <2>;
		battery_design_fcc = <5525>;
		vth_correct_para = <1 2800>;
		vth_correct_para_low_temp = <1 2600>, <2 2800>;
	};

	hisilicon_hisi_vbat_drop_protect_v2 {
		compatible = "hisilicon,hisi_vbat_drop_protect_v2";
		vbat_drop_vol_mv = <2500>;
	};

	hisilicon_hisi_vbat_drop_protect {
		compatible = "hisilicon,hisi_vbat_drop_protect";
		vbat_drop_vol_mv = <2500>;
	};

	huawei_batt_identify {
		compatible = "huawei,batt_identify";
		gpios = <&gpio10 16 0>;
		id_voltage_gpiov = <0 1>;
	};

	huawei_batt_info {
		compatible = "huawei,batt_info";
		sn-check-type = <2>;
	};

	huawei_battery_cccv {
		compatible = "huawei,battery_cccv";
		battery_tbl = "default", "cccv_para0";
	};

	huawei_battery_charge_balance {
		compatible = "huawei,battery_charge_balance";
		unbalance_th = <100 10000>;
	};

	huawei_battery_ocv {
		compatible = "huawei,battery_ocv";
		ocv_table = "-1", "3100", "0", "3200", "1", "3250";
	};

	huawei_battery_temp_fitting {
		compatible = "huawei,battery_temp_fitting";
		btf_temp_lth = "-50";
		fitting_mode = <2>;
		replace_sensor = "bat0_raw_temp";
		temp_para = "-32767", "1", "2300", "0", "4200", "0", "55", "32767", "2300", "0", "4195", "0";
	};

	huawei_boost_5v {
		compatible = "huawei,boost_5v";
		gpio_5v_boost = <&gpio7 27 0>;
	};

	huawei_btb_check {
		compatible = "huawei,btb_check";
		vol_check_para = "1", "1", "2500", "4700", "120", "3", "0";
	};

	huawei_bypass_bst_hl7603 {
		compatible = "huawei,bypass_bst_hl7603";
		const_vout = <3600>;
		gpio_enable = <&gpio10 5 0>;
		ic_role = "0";
		shutdown_cfg = "0xb", "2", "2850", "0xc", "2", "2850";
	};

	huawei_charge_mode_test {
		compatible = "huawei,charge_mode_test";
		test_para = "scp", "lvc", "2000", "105", "0", "2", "scp", "sc4", "3000", "105", "0", "0";
	};

	huawei_charger {
		compatible = "huawei,charger";
		charge_done_sleep_enabled;
		recharge_para = <96 60 3 5 1 0 1 100>;
		support_new_pd_process = <1>;
		weak_source_sleep_enabled;
	};

	huawei_charging_core {
		compatible = "huawei,charging_core";
		ichg_max = <2500>;
		iin_max = <2300>;
		iterm_table = "-32767", "10", "200", "10", "20", "400", "45", "32767", "200";
		jeita_table = "-32767", "1", "2300", "0", "4200", "0", "10", "35", "2300", "3000", "4530", "3", "55", "32767", "2300", "0", "4195", "0";
	};

	huawei_direct_charge_comp {
		compatible = "huawei,direct_charge_comp";
		vbat_comp_ic_para = "schargerV800", "13", "7", "3", "sc8565", "2", "0.5", "3";
	};

	huawei_direct_charge_ic {
		compatible = "huawei,direct_charge_ic";
		ic_para1 = "0", "0", "5000", "0", "0", "1", "1", "5000", "1", "1";
		mode_para = "lvc_mode", "ic_para1", "sc_mode", "ic_para2", "sc4_mode", "ic_para3";
	};

	huawei_direct_charge_turbo {
		compatible = "huawei,direct_charge_turbo";
		time_para_group = "2", "0", "time_para01", "0X1", "4", "0", "time_para02", "0X0";
		time_para01 = "640", "7200", "0", "12500";
	};

	huawei_direct_charger {
		compatible = "huawei,direct_charger";
		bat_para = "default", "10", "15", "volt_para", "CAE", "15", "20", "volt_para1";
		resist_para = "0", "260", "3300", "260", "32767", "2000";
		stage_need_to_jump = "1";
		temp_para = "-32767", "10", "0", "45", "32767", "0";
		use_5A = <1>;
		volt_para = "4080", "5000", "3777", "4555", "1618", "1200";
		volt_para1 = "4500", "5000", "3776", "4555", "2697", "1200";
	};

	huawei_fm1230 {
		compatible = "huawei,fm1230";
		battct_id_gpio-supply = <&huawei_batt_identify>;
		ic_index = <1>;
		onewire-gpio = <&gpio2 14 0>;
		ow_read_end_delay = <100>;
		ow_reset_start_delay = <300>;
	};

	huawei_multi_btb_temp {
		compatible = "huawei,multi_btb_temp";
		sensor-names = "bat0_raw_temp", "comp_para", "0", "bat1_raw_temp", "comp_para1", "0";
	};

	huawei_t91407 {
		compatible = "huawei,t91407";
		battct_id_gpio-supply = <&huawei_batt_identify>;
		onewire-gpio = <&gpio2 14 0>;
	};

	huawei_wireless_charger {
		compatible = "huawei,wireless_charger";
		pmax = <25>;
		rx_mode_para = "5W", "5000", "475", "5000", "5500", "825", "4650", "-1", "-1", "-1", "0", "-1", "4", "SC_4", "15000", "1800", "15000", "15000", "-1", "-1", "46", "-1", "1", "2", "-1", "-1";
		rx_mode_type_para = /bits/ 8 <0 1 1 5 6>;
		sc_err_tx = /bits/ 8 <2>;
		trx_plim = "5000", "5500", "1200", "-1", "2", "-1", "-1", "-1", "12000", "12000", "2300", "-1", "6|9|10", "-1", "3", "-1", "12000", "12000", "2300", "-1", "255", "-1", "3|4", "-1";
	};

	huawei_wireless_sc {
		compatible = "huawei,wireless_sc";
		bat_para = "default", "10", "45", "0x01", "volt_para00", "default", "10", "15", "0x02", "volt_para01";
		init_para = "0x2", "SC_2", "0", "1", "3300", "4500", "9000", "450", "300", "100", "300", "10000", "9000", "2", "0x4", "SC_4", "2", "1", "3200", "4500", "15000", "500", "300", "100", "300", "20000", "15000", "4";
		init_para_col = <14>;
		volt_para00 = "4555", "1802", "386";
		volt_para01 = "4050", "4046", "3237", "4555", "809", "600";
	};

	mt_mt5788 {
		compatible = "mt,mt5788";
		gpio_en = <&gpio2 26 0>;
		gpio_int = <&gpio6 15 0>;
		prevfod1_product_list = /bits/ 8 <17>;
		rx_fod_cond = "0", "-1", "2", "5000", "31", "-1", "-1", "15000";
		rx_mod_cm_cfg = /bits/ 8 <0x5 0x5 0x5>;
		rx_ploss_th0 = /bits/ 8 <0x19 0x32 0x4B 0x64 0x7D 0x96 0xAF 0xE1 0xEB 0x46 0x46 0x46 0x46 0x46 0x46 0x46 0x46 0x46 0x46 0xFF>;
		time_para = < 1800 1250 0 2500 >;
		time_para_group = "SC_2", "1", "time_para01", "SC_4", "0", "time_para";
		tx_current_fod_para = "3", "550", "9900", "300", "9900", "250", "12", "195", "9900", "200", "9900", "1";
	};

	sc8562 {
		compatible = "sc8562";
		fcp_support = <0>;
		gpio_int = <&gpio13 29 0>;
		ic_role = <1>;
		scp_support = <0>;
		sense_r_actual = <10>;
		sense_r_config = <10>;
		slave_mode = <0>;
		vout_ovp_mv = <5000>;
		watchdog_time = <5000>;
	};

	batt_l_v800 {
		/* node-type identity is the node name; no compatible is declared */
		batt_indentify_fcc = <1805>;
		batt_index = <0>;
		batt_name = "battery_gauge";
		r_pcb = <23330>;
		soe_dynamic_enable = <1>;
	};

	batt {
		/* node-type identity is the node name; no compatible is declared */
		batt_indentify_fcc = <3590>;
		batt_index = <1>;
		batt_name = "battery_gauge_aux";
		r_pcb = <11920>;
		soe_dynamic_enable = <1>;
	};

	battery_checker {
		/* node-type identity is the node name; no compatible is declared */
		matchable = <&fm1230 &t91407>;
		spare-cycles = <150>;
	};

	battery0 {
		/* node-type identity is the node name; no compatible is declared */
		cccv_0 = <4500 0>;
		cccv_10_20 = <4200 3610 4250 2707 4555 1260>;
		temp_tab = "0", "cccv_0", "20", "cccv_10_20";
		weight = <1805>;
	};

	battery1 {
		/* node-type identity is the node name; no compatible is declared */
		cccv_10_20 = <4200 7180 4500 3590 4555 2513>;
		temp_tab = "0", "cccv_0", "20", "cccv_10_20";
		weight = <3590>;
	};

	cccv_para0 {
		/* node-type identity is the node name; no compatible is declared */
		buck_cccv_0_5 = < 4540 1078 0>;
		buck_temp_tab = "5", "buck_cccv_0_5";
		cccv_10_20 = <4200 10790 0 4250 8092 0 4565 2697 0>;
		temp_tab = "20", "cccv_10_20";
	};

	charging_core {
		/* node-type identity is the node name; no compatible is declared */
		battery-thermal-derate-curve;
		fast-charge-profile-matrix;
	};

	i2c {
		/* node-type identity is the node name; no compatible is declared */
		hold-time = <0x220022>;
	};

	middle_cpu {
		/* node-type identity is the node name; no compatible is declared */
		active_perf_limit = < 16 100 100 6 15 100 0 5 100>;
		passive_perf_limit = < 0 5 10 40 10 0 6 15 10 70 10 0 16 100 0 100 10 0>;
	};

	/ {
		/* node-type identity is the node name; no compatible is declared */
		board_id = <12345>;
	};

	scharger_v800_buck {
		/* node-type identity is the node name; no compatible is declared */
		cur_balance_mos = <2>;
		pswovp_sw_flag = "rxsw", "1", "0", "1";
		r_charger_uohm = <1000>;
		usbovp_sw_flag = "buck", "0", "1", "1";
	};

	scharger_v800_flash {
		/* node-type identity is the node name; no compatible is declared */
		vendor,led-type = <0>;
	};

	scharger_v800 {
		/* node-type identity is the node name; no compatible is declared */
		gpios = <&gpio5 31 0>;
	};
};
