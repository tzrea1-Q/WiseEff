# Private publication-manager credentials. Copy to
# ops/self-hosted/.env.publication-manager and do not add these keys to the
# public .env used by api/worker/web.
#
# LOGIN must be able to SET ROLE catalog_publication_coordinator_role and
# catalog_synchronizer_role. It must not be a database superuser.
# Ordinary API DATABASE_URL must not be copied here if that LOGIN is the
# application owner; provision a dedicated manager LOGIN instead.

WISEEFF_PUBLICATION_MANAGER=1
# Leave the next line unset until provision-logins creates wiseeff_publication_manager.
# Never copy DATABASE_URL here.
# WISEEFF_PUBLICATION_MANAGER_DATABASE_URL=postgres://wiseeff_publication_manager:change-me@postgres:5432/wiseeff
WISEEFF_PUBLICATION_MANAGER_LEASE_MS=30000
WISEEFF_PUBLICATION_MANAGER_RETRY_BUDGET=5
WISEEFF_PUBLICATION_MANAGER_POLL_INTERVAL_MS=1000
WISEEFF_PUBLICATION_MANAGER_ACTIVATION_TIMEOUT_MS=60000
WISEEFF_PUBLICATION_MANAGER_HEALTH_PORT=8791
WISEEFF_UPGRADE_ACTOR_PRINCIPAL_ID=deployment-upgrade
