# WiseEff restricted-network build transport. Parsed as allowlisted data; never sourced.
# Install as .build-network.env with mode 0600. Shell variables override matching entries.

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Optional internal npm registry. npm ci replaces every lockfile registry host when set.
WISEEFF_NPM_REGISTRY=

# Optional absolute or config-relative PEM bundle approved by your organization.
WISEEFF_BUILD_CA_CERT_FILE=

# Opt in only when API/worker runtime downloads also require this proxy.
WISEEFF_RUNTIME_PROXY=false
