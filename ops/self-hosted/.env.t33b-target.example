# Local self-hosted T3.3b target example. Copy to .env.t33b-target (gitignored).
# Not compose 5432/wiseeff. Public URL is loopback:18080.

WISEEFF_ENV_FILE=.env.t33b-target
WISEEFF_PUBLICATION_MANAGER_ENV_FILE=.env.publication-manager.t33b-target
WISEEFF_DEPLOY_PROFILE=ip-lab
WISEEFF_TLS_MODE=http
WISEEFF_CADDYFILE=Caddyfile.ip-lab
WISEEFF_SITE_HOST=127.0.0.1
WISEEFF_TLS_EMAIL=unused-t33b-target@localhost
WISEEFF_PUBLIC_URL=http://127.0.0.1:18080
WISEEFF_LAB_ADMIN_USERNAME=admin.ops
WISEEFF_LAB_ADMIN_PASSWORD=t33b-admin-secret-32chars
WISEEFF_LAB_ADMIN_NAME=T33B Target Admin
WISEEFF_LAB_SEED=chargelab

WISEEFF_APP_IMAGE=wiseeff-app
WISEEFF_APP_TAG=t33b-19b987e5a

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

POSTGRES_PASSWORD=t33b-postgres-secret-32chars
DATABASE_URL=postgres://wiseeff:t33b-postgres-secret-32chars@postgres:5432/wiseeff
WISEEFF_CATALOG_BOOTSTRAP_DATABASE_URL=postgres://wiseeff:t33b-postgres-secret-32chars@postgres:5432/wiseeff
WISEEFF_WORKER_DATABASE_URL=postgres://wiseeff:t33b-postgres-secret-32chars@postgres:5432/wiseeff

AUTH_MODE=production
AUTH_PROVIDER=local
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=

WISEEFF_API_BASE_URL=http://127.0.0.1:18080
VITE_WISEEFF_RUNTIME_MODE=api
VITE_WISEEFF_API_BASE_URL=http://127.0.0.1:18080

MINIO_ROOT_USER=t33b-minio
MINIO_ROOT_PASSWORD=t33b-minio-secret-32chars
OBJECT_STORE_MODE=s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=wiseeff
OBJECT_STORAGE_ACCESS_KEY_ID=t33b-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=t33b-minio-secret-32chars
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_TLS_POLICY=optional
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_HEALTH_PREFIX=.health/
OBJECT_STORAGE_RETENTION_CLASS=pilot-default

BACKUP_DATABASE_TARGET=file:///var/backups/wiseeff/postgres/wiseeff.dump
BACKUP_OBJECT_STORAGE_TARGET=file:///var/backups/wiseeff/object-store/
RESTORE_DATABASE_URL=postgres://wiseeff_restore:restore-password@postgres:5432/wiseeff_restore
RESTORE_OBJECT_STORAGE_BUCKET=wiseeff-restore
RESTORE_OBJECT_STORAGE_PREFIX=t33b-drill/

DEBUG_DEVICE_GATEWAY_MODE=multi
DEVICE_GATEWAY_ALLOW_SIMULATOR_IN_PRODUCTION=true
HDC_TIMEOUT_MS=5000
ADB_TIMEOUT_MS=5000

DEVICE_BRIDGE_ARTIFACT_ROOT=ops/self-hosted/bridge-artifacts
DEVICE_BRIDGE_TOOL_ARTIFACT_ROOT=ops/self-hosted/bridge-tool-artifacts
DEVICE_BRIDGE_PAIRING_TTL_SECONDS=1800
DEVICE_BRIDGE_TOKEN_TTL_DAYS=90
DEVICE_BRIDGE_WS_PATH=/api/v1/device-bridges/ws
DEVICE_BRIDGE_LAB_AVAILABLE=false
DEVICE_BRIDGE_SERVER_URL=http://127.0.0.1:18080

XIAOZE_LLM_API_BASE_URL=
XIAOZE_LLM_MODEL=
XIAOZE_LLM_API_KEY=
AGENT_API_TIMEOUT_MS=30000
XIAOZE_CHECKPOINTER=postgres
XIAOZE_DETERMINISTIC=true

LOG_ANALYSIS_API_BASE_URL=
LOG_ANALYSIS_MODEL=
LOG_ANALYSIS_API_KEY=
LOG_ANALYSIS_API_TIMEOUT_MS=30000
LOG_ANALYSIS_TOKEN_BUDGET=8000
LOG_ANALYSIS_DETERMINISTIC=true

LOG_WORKER_ENABLED=false
LOG_ANALYSIS_QUEUE_MODE=durable
REDIS_URL=redis://redis:6379
LOG_ANALYSIS_QUEUE_PREFIX=wiseeff
LOG_ANALYSIS_QUEUE_ATTEMPTS=4
LOG_ANALYSIS_QUEUE_BACKOFF_MS=1000
LOG_ANALYSIS_QUEUE_CONCURRENCY=1
LOG_WORKER_OBSERVABILITY_HOST=127.0.0.1
LOG_WORKER_OBSERVABILITY_PORT=8788

WISEEFF_GRAFANA_PORT=13000
WISEEFF_PROMETHEUS_PORT=19090
WISEEFF_ALERTMANAGER_PORT=19093
WISEEFF_PROMETHEUS_RETENTION=15d

M5_CONTRACT_CHECK_PASSED=true
M5_BACKUP_RESTORE_DRILL_AT=
M5_SMOKE_ALLOW_NO_API=false
