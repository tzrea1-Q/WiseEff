# Stable protocol consumed by the source-checkout upgrade launcher.
WISEEFF_UPGRADE_PROTOCOL_VERSION=1
WISEEFF_UPGRADE_MIN_PROTOCOL_VERSION=1
# Catalog apply keys. Mode is never silently defaulted; the operator must pass
# exactly one of fresh or populated at catalog-apply time.
WISEEFF_CATALOG_APPLY_MODE=
WISEEFF_CATALOG_UPGRADE_JOURNAL=
# Operator attestation that writers, queue, and proxy are quiesced. This is not
# P2 proof. Catalog apply fails closed unless the invoking command sets
# WISEEFF_CATALOG_QUIESCED to true.
WISEEFF_CATALOG_QUIESCED=
