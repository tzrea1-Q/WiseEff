+  const keys = new Set<string>();
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim();
+    if (line.startsWith("#!") || /\u0000|\$\(|`|;|&&|\|\|/.test(line)) fail("private-config-not-data-only");
