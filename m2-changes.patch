+  classification: ClassificationResult;
+  conversion: ConversionManifest;
+  bundle: CatalogReleaseBundle;
+  p7Pins: readonly BindingMappingPin[];
+  archive: Omit<ArchiveAdapterOptions,"client" | "failAfter">;
+  operatorAuditRef: string;
+  retainUntil: Date;
